# Copie para .env.local e preencha. Localmente, `pnpm supabase status` mostra os valores.
# O .env.local deve apontar EXCLUSIVAMENTE para o Supabase LOCAL (127.0.0.1). pnpm dev, pnpm start,
# pnpm super-admin e pnpm test recusam qualquer outro host. Não coloque credenciais remotas aqui:
# produção usa só as variáveis da Vercel e os secrets do GitHub. Veja AGENTS.md.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
