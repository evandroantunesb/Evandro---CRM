+/**
+ * Quatro contas feitas à mão (decisão técnica de 22/10/2026, PENDENTE de aceite do Evandro) conferidas contra o módulo
+ * isolado `fio-b-hipotese.ts`. Só teste: nada aqui liga a hipótese ao motor real.
+ *
+ * Dados oficiais (ANEEL, Componentes Tarifárias 2026 e Tarifas de Aplicação; REH 3.592/2026, COPEL-DIS, vigência
+ * 24/06/2026 a 23/06/2027; B1 Convencional, Residencial, "Tarifa de Aplicação", sem tributos, R$/MWh):
+ *   TE 310,85 + TUSD 457,17 => T = 0,76802 R$/kWh
+ *   TUSD_FioB 214,535600374 => N (GD II 2026, Lei 14.300 art. 27, IV: 60%) = 0,6 × 0,214535600374 = 0,1287213602 R$/kWh
+ * Piso: bifásico a três condutores, D = 50 kWh (REN 1.000, art. 291, II).
+ */
+import { describe, expect, it } from "vitest";
+import { calcularFioBHipotese } from "@/lib/fio-b-hipotese";
+
+const T = (310.85 + 457.17) / 1000;
+const N = (0.6 * 214.535600374) / 1000;
+const D = 50;
+
+const caso = (consumoTotalKwh: number, geracaoTotalKwh: number) =>
+  calcularFioBHipotese({ consumoTotalKwh, geracaoTotalKwh, tarifaCheiaRsKwh: T, custoDisponibilidadeKwh: D, custoEnergiaCompensadaRsKwh: N });
+
+describe("Copel B1 convencional GD II 2026: quatro casos feitos à mão", () => {
+  it("1. geração zero (300 kWh): sem = com = 300 × T = 230,41; economia 0", () => {
+    expect(caso(300, 0)).toMatchObject({ ok: true, energiaCompensadaKwh: 0, contaSemSolar: 230.41, contaComSolar: 230.41, economiaMensal: 0, paybackDisponivel: false });
+  });
+
+  it("2. consumo abaixo do piso (40 kWh, gera 200): as duas contas no piso 50 × T = 38,40; nada compensado", () => {
+    expect(caso(40, 200)).toMatchObject({
+      ok: true,
+      energiaCompensadaKwh: 0,
+      energiaDisponivelNaoCompensadaKwh: 200,
+      contaSemSolar: 38.4,
+      contaComSolar: 38.4,
+      economiaMensal: 0,
+      paybackDisponivel: false,
+    });
+  });
+
+  it("3. compensação parcial (500 kWh, gera 300): com = 200 × T + 300 × N = 192,22; economia 191,79", () => {
+    expect(caso(500, 300)).toMatchObject({ ok: true, energiaCompensadaKwh: 300, contaSemSolar: 384.01, contaComSolar: 192.22, economiaMensal: 191.79 });
+  });
+
+  it("4. compensação total (400 kWh, gera 500): K = 400; com = 400 × N = 51,49; economia 255,72; sobram 100 kWh", () => {
+    expect(caso(400, 500)).toMatchObject({
+      ok: true,
+      energiaCompensadaKwh: 400,
+      energiaDisponivelNaoCompensadaKwh: 100,
+      contaSemSolar: 307.21,
+      contaComSolar: 51.49,
+      economiaMensal: 255.72,
+    });
+  });
+
+  it("4b. geração sobra mas o piso limita (200 kWh, gera 400): K = 180,20; com = 38,40 (piso); economia 115,20", () => {
+    expect(caso(200, 400)).toMatchObject({ ok: true, energiaCompensadaKwh: 180.2, contaSemSolar: 153.6, contaComSolar: 38.4, economiaMensal: 115.2 });
+  });
+});
