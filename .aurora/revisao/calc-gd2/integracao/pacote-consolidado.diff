+  return `${formatarDataIso(inicio)} a ${formatarDataIso(fim)}`;
+}
diff --git a/supabase/migrations/20261022100000_propostas_emissoes.sql b/supabase/migrations/20261022100000_propostas_emissoes.sql
new file mode 100644
index 0000000..e37baee
--- /dev/null
+++ b/supabase/migrations/20261022100000_propostas_emissoes.sql
@@ -0,0 +1,216 @@
+-- Emissão preservada da proposta (M2 P0): cada proposta emitida é uma linha IMUTÁVEL com os dados exatos que
+-- o cliente vê (jsonb) e o PDF final guardado em bucket privado, com link próprio. Nada é recalculado nem relido do
+-- negócio, do kit ou do cálculo depois de emitir; corrigir = emitir uma nova versão.
+--
+-- Migration ADITIVA: não altera `propostas` nem nenhuma outra tabela. Propostas antigas (sem emissão) continuam
+-- sem dados preservados (link com aviso, PDF 409).
+--
+-- Preço e condições são dado comercial/financeiro: leitura e emissão exigem papel comercial (admin, gestor ou
+-- vendedor, `tem_acesso_financeiro`), além de enxergar o negócio. O SDR não lê nem emite.
+
+create table public.propostas_emissoes (
+  id uuid primary key default gen_random_uuid(),
+  empresa_id uuid not null references public.empresas (id) on delete cascade,
+  -- Sem cascata pelo negócio (NO ACTION, como os pagamentos): negócio com proposta emitida não pode ser apagado (só
+  -- arquivado), então o registro do que o cliente recebeu não some por um DELETE do negócio. A remoção da EMPRESA
+  -- continua em cascata (empresa_id acima); a conferência de NO ACTION só ocorre no fim do comando.
+  negocio_id uuid not null references public.negocios (id),
+  versao integer not null check (versao > 0),
+  -- Token do link público da VERSÃO (cada emissão tem o seu): a posse do token autoriza a leitura, como em `propostas`.
+  token text not null unique default gen_random_uuid()::text,
+  tipo text not null default 'simples' check (tipo in ('simples')),
+  -- Tudo o que a página pública e o PDF exibem (cliente, sistema, kit, preço, condições, validade, identidade).
+  dados jsonb not null check (jsonb_typeof(dados) = 'object'),
+  dados_sha256 text not null check (dados_sha256 ~ '^[0-9a-f]{64}$'),
+  -- Validade informada pelo vendedor na emissão (sem padrão: nunca inventada pelo sistema).
+  validade_ate date not null,
+  -- Caminho no bucket 'propostas-emitidas': <empresa_id>/<negocio_id>/<id>.pdf
+  pdf_caminho text not null check (pdf_caminho = empresa_id::text || '/' || negocio_id::text || '/' || id::text || '.pdf'),
+  pdf_sha256 text not null check (pdf_sha256 ~ '^[0-9a-f]{64}$'),
+  pdf_bytes integer not null check (pdf_bytes > 0),
+  -- Versão do layout que gerou o PDF (para saber qual renderizador produziu aquele arquivo).
+  renderizador text not null check (length(trim(renderizador)) > 0),
+  emitida_em timestamptz not null default now(),
+  emitida_por uuid not null references public.empresa_membros (id),
+  unique (negocio_id, versao)
+);
+create index on public.propostas_emissoes (empresa_id);
+
+-- ---------------------------------------------------------------------------
+-- Imutabilidade: nenhum UPDATE nem DELETE direto, para ninguém (inclusive service_role).
+-- Só a remoção em CASCATA da EMPRESA é permitida: ela roda dentro de um gatilho de integridade referencial
+-- (pg_trigger_depth() > 1) e a empresa já não existe quando a linha é apagada. Qualquer outro DELETE/UPDATE, de
+-- sessão ou aninhado em outro gatilho, é recusado.
+-- ---------------------------------------------------------------------------
+
+create or replace function public.recusar_alteracao_emissao()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  if tg_op = 'DELETE' and pg_trigger_depth() > 1 and not exists (select 1 from public.empresas e where e.id = old.empresa_id) then
+    return old;
+  end if;
+  raise exception 'Proposta emitida não pode ser alterada nem apagada: emita uma nova versão.'
+    using errcode = 'check_violation', hint = 'mensagem_usuario';
+end;
+$$;
+
+create trigger propostas_emissoes_imutavel
+  before update or delete on public.propostas_emissoes
+  for each row execute function public.recusar_alteracao_emissao();
+
+create or replace function public.recusar_truncate_emissao()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  raise exception 'Proposta emitida não pode ser apagada.' using errcode = 'check_violation';
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- INSERT: o servidor não confia nos campos que o cliente da API envia. Quem insere (mesmo com o JWT do usuário, direto
+-- em /rest/v1) não escolhe o token (sempre sorteado aqui), nem a versão (sempre a próxima do negócio, sob trava), e
+-- os campos relacionais precisam bater com o que está dentro de `dados` (que é o que o cliente vê).
+-- ---------------------------------------------------------------------------
+
+create or replace function public.conferir_emissao_proposta()
+returns trigger
+language plpgsql security definer set search_path = ''
+as $$
+declare
+  v_proxima integer;
+  v_validade date;
+  v_emitida timestamptz;
+begin
+  -- Este gatilho roda ANTES da RLS (security definer): quem não enxerga o negócio é recusado aqui, sem pista alguma
+  -- (nem contagem de versões, nem trava no negócio alheio). Service role (sem auth.uid) não passa por esta checagem.
+  if auth.uid() is not null
+     and not (public.pode_ver_negocio(new.negocio_id) and public.tem_acesso_financeiro(new.empresa_id)) then
+    raise exception 'Não foi possível emitir a proposta.' using errcode = 'insufficient_privilege';
+  end if;
+
+  -- Serializa as emissões do mesmo negócio.
+  perform pg_advisory_xact_lock(hashtextextended('propostas_emissoes:' || new.negocio_id::text, 0));
+
+  new.token := gen_random_uuid()::text;
+
+  select coalesce(max(e.versao), 0) + 1 into v_proxima from public.propostas_emissoes e where e.negocio_id = new.negocio_id;
+  if new.versao <> v_proxima then
+    raise exception 'A versão da proposta precisa ser a próxima do negócio.'
+      using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end if;
+
+  begin
+    v_validade := (new.dados -> 'comercial' ->> 'validadeAte')::date;
+    v_emitida := (new.dados -> 'emissao' ->> 'emitidaEm')::timestamptz;
+    if (new.dados -> 'emissao' ->> 'versao')::integer is distinct from new.versao then
+      raise exception 'versao' using errcode = 'check_violation';
+    end if;
+  exception when others then
+    raise exception 'Os dados da proposta não conferem com a emissão.' using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end;
+  if v_validade is distinct from new.validade_ate or v_emitida is distinct from new.emitida_em then
+    raise exception 'Os dados da proposta não conferem com a emissão.' using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end if;
+  if new.validade_ate < (now() at time zone 'America/Sao_Paulo')::date then
+    raise exception 'A validade da proposta não pode ser anterior a hoje.' using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end if;
+  -- A hora da emissão é a do servidor, com folga para o tempo de gerar o PDF e o relógio do app.
+  if new.emitida_em < now() - interval '10 minutes' or new.emitida_em > now() + interval '2 minutes' then
+    raise exception 'A hora da emissão não confere.' using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end if;
+  -- A linha só nasce amarrada ao PDF que o app guardou (só o service role envia ao bucket): sem arquivo, sem emissão.
+  if not exists (
+    select 1 from storage.objects o
+     where o.bucket_id = 'propostas-emitidas' and o.name = new.pdf_caminho and (o.metadata ->> 'size')::bigint = new.pdf_bytes
+  ) then
+    raise exception 'O PDF da proposta não foi encontrado.' using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end if;
+  return new;
+end;
+$$;
+revoke all on function public.conferir_emissao_proposta() from public, anon, authenticated, service_role;
+
+-- O prefixo "0" faz este gatilho rodar antes do de arquivado (ordem alfabética): a checagem de acesso vem primeiro.
+create trigger propostas_emissoes_0conferir
+  before insert on public.propostas_emissoes
+  for each row execute function public.conferir_emissao_proposta();
+
+-- Negócio arquivado é somente leitura: nenhuma proposta nasce nele (como as demais tabelas comerciais).
+create trigger propostas_emissoes_arquivado_somente_leitura
+  before insert on public.propostas_emissoes
+  for each row execute function public.negocio_arquivado_bloquear_filho();
+
+create trigger propostas_emissoes_sem_truncate
+  before truncate on public.propostas_emissoes
+  for each statement execute function public.recusar_truncate_emissao();
+
+-- ---------------------------------------------------------------------------
+-- RLS: só SELECT e INSERT para usuários autenticados; nenhuma policy de UPDATE/DELETE.
+-- ---------------------------------------------------------------------------
+
+alter table public.propostas_emissoes enable row level security;
+
+revoke all on public.propostas_emissoes from anon;
+revoke update, delete, truncate on public.propostas_emissoes from authenticated;
+
+create policy "ver emissoes de proposta" on public.propostas_emissoes for select to authenticated
+  using (public.pode_ver_negocio(negocio_id) and public.tem_acesso_financeiro(empresa_id));
+
+-- O vendedor só emite em nome dele (`emitida_por`) e só para negócio da própria empresa que ele enxerga.
+create policy "emitir proposta" on public.propostas_emissoes for insert to authenticated
+  with check (
+    public.membro_ativo(empresa_id)
+    and public.tem_acesso_financeiro(empresa_id)
+    and public.pode_ver_negocio(negocio_id)
+    and emitida_por = public.meu_membro_id(empresa_id)
+    and exists (select 1 from public.negocios n where n.id = propostas_emissoes.negocio_id and n.empresa_id = propostas_emissoes.empresa_id)
+  );
+
+-- ---------------------------------------------------------------------------
+-- Storage: bucket privado só para os PDFs emitidos (até 10 MB, só PDF).
+-- Sem policy de INSERT/UPDATE/DELETE para usuários: o envio é feito só pela ação de emitir (service role), uma vez,
+-- e nunca sobrescrito (cada PDF tem o id da emissão no nome). A leitura pública é pela rota do token (service role),
+-- que confere o SHA-256 gravado antes de devolver os bytes.
+-- ---------------------------------------------------------------------------
+
+insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
+values ('propostas-emitidas', 'propostas-emitidas', false, 10485760, array['application/pdf'])
+on conflict (id) do nothing;
+
+-- Caminho: <empresa_id>/<negocio_id>/<emissao_id>.pdf
+create or replace function public.pode_ver_pdf_proposta_emitida(p_caminho text)
+returns boolean
+language plpgsql stable security definer set search_path = ''
+as $$
+declare
+  v_partes text[] := string_to_array(p_caminho, '/');
+  v_negocio uuid;
+begin
+  if coalesce(array_length(v_partes, 1), 0) <> 3 then
+    return false;
+  end if;
+  begin
+    v_negocio := v_partes[2]::uuid;
+  exception when invalid_text_representation then
+    return false;
+  end;
+  return exists (
+    select 1 from public.negocios n
+    where n.id = v_negocio
+      and n.empresa_id::text = v_partes[1]
+      and public.pode_ver_negocio(n.id)
+      and public.tem_acesso_financeiro(n.empresa_id)
+  );
+end;
+$$;
+
+revoke all on function public.pode_ver_pdf_proposta_emitida(text) from public, anon;
+grant execute on function public.pode_ver_pdf_proposta_emitida(text) to authenticated;
+
+create policy "propostas emitidas: ler" on storage.objects for select to authenticated
+  using (bucket_id = 'propostas-emitidas' and public.pode_ver_pdf_proposta_emitida(name));
diff --git a/supabase/migrations/20261022110000_produtividade_confirmada.sql b/supabase/migrations/20261022110000_produtividade_confirmada.sql
new file mode 100644
index 0000000..2a1812c
--- /dev/null
+++ b/supabase/migrations/20261022110000_produtividade_confirmada.sql
@@ -0,0 +1,105 @@
+-- Confirmação da produtividade da calculadora (M2 P0). A geração estimada que a proposta mostra ao cliente é
+-- potência do kit × `produtividade_kwh_kwp_mes` da empresa. O padrão (120) é uma simplificação nacional que a própria
+-- migration original manda calibrar com o engenheiro responsável antes do uso com clientes. Para uma proposta emitida
+-- poder mostrar a geração, o ADMIN da empresa precisa ter confirmado o valor atual informando o VALOR, a FONTE (de onde
+-- ele vem) e o RESPONSÁVEL pela validação (quem o calibrou).
+--
+-- A confirmação vale enquanto a produtividade for igual ao valor confirmado: qualquer mudança no parâmetro a apaga
+-- (gatilho). Só a função `confirmar_produtividade_calculadora` grava os campos de confirmação, e só se o valor
+-- informado for o valor atual (o admin confirma o que viu). Migration aditiva: nenhum dado existente muda; todas as
+-- empresas começam SEM confirmação (sem geração nas propostas emitidas até confirmarem).
+
+alter table public.parametros_calculadora
+  add column produtividade_confirmada_valor numeric(6, 2),
+  add column produtividade_confirmada_em timestamptz,
+  add column produtividade_confirmada_por uuid references public.empresa_membros (id) on delete set null,
+  add column produtividade_confirmada_fonte text,
+  add column produtividade_confirmada_responsavel text,
+  add constraint produtividade_confirmada_completa check (
+    (produtividade_confirmada_valor is null and produtividade_confirmada_em is null
+      and produtividade_confirmada_fonte is null and produtividade_confirmada_responsavel is null)
+    or (produtividade_confirmada_valor is not null and produtividade_confirmada_em is not null
+        and produtividade_confirmada_fonte is not null and length(btrim(produtividade_confirmada_fonte)) between 10 and 120
+        and produtividade_confirmada_responsavel is not null and length(btrim(produtividade_confirmada_responsavel)) between 3 and 60)
+  );
+
+-- Os campos de confirmação só mudam pela função (que liga a bandeira local) ou são apagados quando a produtividade muda.
+create or replace function public.guardar_confirmacao_produtividade()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  if tg_op = 'UPDATE' and new.produtividade_kwh_kwp_mes is distinct from old.produtividade_kwh_kwp_mes then
+    new.produtividade_confirmada_valor := null;
+    new.produtividade_confirmada_em := null;
+    new.produtividade_confirmada_por := null;
+    new.produtividade_confirmada_fonte := null;
+    new.produtividade_confirmada_responsavel := null;
+    return new;
+  end if;
+  -- Apagar o membro que confirmou (ON DELETE SET NULL) só zera o autor; a confirmação em si continua. Vale só quando o
+  -- membro já não existe: ninguém apaga o autor de uma confirmação válida por fora da função.
+  if (new.produtividade_confirmada_valor, new.produtividade_confirmada_em, new.produtividade_confirmada_fonte, new.produtividade_confirmada_responsavel)
+       is not distinct from
+     (old.produtividade_confirmada_valor, old.produtividade_confirmada_em, old.produtividade_confirmada_fonte, old.produtividade_confirmada_responsavel)
+     and old.produtividade_confirmada_por is not null and new.produtividade_confirmada_por is null
+     and not exists (select 1 from public.empresa_membros m where m.id = old.produtividade_confirmada_por) then
+    return new;
+  end if;
+  if (new.produtividade_confirmada_valor, new.produtividade_confirmada_em, new.produtividade_confirmada_por,
+      new.produtividade_confirmada_fonte, new.produtividade_confirmada_responsavel)
+       is distinct from
+     (old.produtividade_confirmada_valor, old.produtividade_confirmada_em, old.produtividade_confirmada_por,
+      old.produtividade_confirmada_fonte, old.produtividade_confirmada_responsavel)
+     and coalesce(current_setting('raion.confirmando_produtividade', true), '') <> 'on' then
+    raise exception 'A confirmação da produtividade só pode ser feita pela função de confirmação.'
+      using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end if;
+  return new;
+end;
+$$;
+
+create trigger parametros_calculadora_confirmacao
+  before update on public.parametros_calculadora
+  for each row execute function public.guardar_confirmacao_produtividade();
+
+create or replace function public.confirmar_produtividade_calculadora(p_empresa_id uuid, p_valor numeric, p_fonte text, p_responsavel text)
+returns void
+language plpgsql security definer set search_path = ''
+as $$
+declare
+  v_fonte text := nullif(btrim(p_fonte), '');
+  v_responsavel text := nullif(btrim(p_responsavel), '');
+  v_atual numeric;
+begin
+  if not public.tem_papel(p_empresa_id, '{admin}') then
+    raise exception 'Só o administrador da empresa confirma a produtividade.' using errcode = 'insufficient_privilege', hint = 'mensagem_usuario';
+  end if;
+  if v_fonte is null or length(v_fonte) < 10 or length(v_fonte) > 120 then
+    raise exception 'Informe a fonte do valor (de 10 a 120 caracteres), por exemplo o estudo de irradiação usado.' using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end if;
+  if v_responsavel is null or length(v_responsavel) < 3 or length(v_responsavel) > 60 then
+    raise exception 'Informe quem validou o valor (de 3 a 60 caracteres).' using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end if;
+  -- Trava a linha: o valor lido aqui é o que será confirmado (sem corrida com quem muda a produtividade).
+  select produtividade_kwh_kwp_mes into v_atual from public.parametros_calculadora where empresa_id = p_empresa_id for update;
+  if not found then
+    raise exception 'Parâmetros da calculadora não encontrados.' using errcode = 'no_data_found', hint = 'mensagem_usuario';
+  end if;
+  -- O admin confirma o valor que viu: se ele mudou nesse meio tempo, a confirmação é recusada.
+  if p_valor is null or round(p_valor, 2) <> round(v_atual, 2) then
+    raise exception 'O valor informado não é o valor atual da produtividade. Recarregue a página e confirme de novo.' using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end if;
+  perform set_config('raion.confirmando_produtividade', 'on', true);
+  update public.parametros_calculadora
+     set produtividade_confirmada_valor = produtividade_kwh_kwp_mes,
+         produtividade_confirmada_em = now(),
+         produtividade_confirmada_por = public.meu_membro_id(p_empresa_id),
+         produtividade_confirmada_fonte = v_fonte,
+         produtividade_confirmada_responsavel = v_responsavel
+   where empresa_id = p_empresa_id;
+end;
+$$;
+revoke all on function public.confirmar_produtividade_calculadora(uuid, numeric, text, text) from public, anon;
+grant execute on function public.confirmar_produtividade_calculadora(uuid, numeric, text, text) to authenticated;
diff --git a/supabase/migrations/20261023200000_calculos_estimativa_incompleta.sql b/supabase/migrations/20261023200000_calculos_estimativa_incompleta.sql
new file mode 100644
index 0000000..719fdb0
--- /dev/null
+++ b/supabase/migrations/20261023200000_calculos_estimativa_incompleta.sql
@@ -0,0 +1,63 @@
+-- Estimativa financeira incompleta persistida (M2 P0, calculadora; Evandro, 22/10/2026).
+--
+-- Até aqui, `calculos_solares` só aceitava a linha com TODOS os números financeiros (NOT NULL): a estimativa
+-- incompleta não era gravada e o kit salvo ficava sem registro do resultado técnico. Esta migration permite gravar
+-- o resultado técnico (kit, potência, ligação, consumo, tarifa informada, produtividade, geração) SEM economia, conta,
+-- Fio B nem payback, com a lista de pendências que impede a parte financeira.
+--
+-- `estado_financeiro`:
+--   legado     = linha gerada pela fórmula antiga (não validada). Todas as linhas existentes (default no ADD COLUMN,
+--                sem reescrita de dados). Números financeiros presentes; sem método; nunca entram em proposta.
+--   incompleto = resultado técnico sem parte financeira: os seis números financeiros e o payback são NULOS (ausência
+--                nunca vira zero), `pendencias` é um array JSON não vazio e não há método.
+--   completo   = parte financeira calculada pela regra validada: números presentes e `metodo_calculo` obrigatório.
+--                Nenhum código grava este estado ainda (só depois do aceite da regra e dos dados de Fio B).
+--
+-- Aditiva e compatível: colunas novas com default constante (sem reescrita), DROP NOT NULL e CHECKs criados NOT VALID
+-- e validados em seguida (as linhas existentes já cumprem a regra de `legado`). Leitores antigos continuam lendo as
+-- linhas legadas iguais; os tipos gerados passam a marcar os números financeiros como anuláveis.
+
+alter table public.calculos_solares
+  add column estado_financeiro text not null default 'legado',
+  add column metodo_calculo text,
+  add column pendencias jsonb;
+
+alter table public.calculos_solares
+  alter column kwh_faturado drop not null,
+  alter column kwh_compensado drop not null,
+  alter column custo_fio_b drop not null,
+  alter column conta_sem_solar drop not null,
+  alter column conta_com_solar drop not null,
+  alter column economia_mensal drop not null;
+
+alter table public.calculos_solares
+  add constraint calculos_solares_estado_financeiro_ck
+    check (estado_financeiro in ('legado', 'incompleto', 'completo')) not valid,
+  add constraint calculos_solares_estado_coerente_ck check (
+    case estado_financeiro
+      when 'incompleto' then
+        kwh_faturado is null and kwh_compensado is null and custo_fio_b is null
+        and conta_sem_solar is null and conta_com_solar is null and economia_mensal is null
+        and payback_meses is null and metodo_calculo is null
+        and coalesce(jsonb_typeof(pendencias) = 'array' and pendencias <> '[]'::jsonb, false)
+      when 'legado' then
+        kwh_faturado is not null and kwh_compensado is not null and custo_fio_b is not null
+        and conta_sem_solar is not null and conta_com_solar is not null and economia_mensal is not null
+        and metodo_calculo is null and pendencias is null
+      when 'completo' then
+        kwh_faturado is not null and kwh_compensado is not null and custo_fio_b is not null
+        and conta_sem_solar is not null and conta_com_solar is not null and economia_mensal is not null
+        and length(btrim(coalesce(metodo_calculo, ''))) > 0 and pendencias is null
+      else false
+    end
+  ) not valid;
+
+alter table public.calculos_solares validate constraint calculos_solares_estado_financeiro_ck;
+alter table public.calculos_solares validate constraint calculos_solares_estado_coerente_ck;
+
+comment on column public.calculos_solares.estado_financeiro is
+  'legado = fórmula antiga (não validada, nunca entra em proposta); incompleto = resultado técnico sem parte financeira (números nulos + pendências); completo = regra validada (exige metodo_calculo).';
+comment on column public.calculos_solares.pendencias is
+  'Só no estado incompleto: array JSON de {codigo, mensagem} com o que impede a parte financeira.';
+comment on column public.calculos_solares.metodo_calculo is
+  'Só no estado completo: identificador da regra validada que gerou os números financeiros.';
diff --git a/supabase/migrations/20261023210000_calculo_gd2_fio_b.sql b/supabase/migrations/20261023210000_calculo_gd2_fio_b.sql
new file mode 100644
index 0000000..57d96a0
--- /dev/null
+++ b/supabase/migrations/20261023210000_calculo_gd2_fio_b.sql
@@ -0,0 +1,189 @@
+-- Estimativa financeira GD II pela regra aceita (M2 P0, calculadora; contrato .aurora/contratos/m2-p0-decisao-fio-b-copel.md).
+--
+-- Três peças, todas aditivas:
+--  1) `tarifas_gd_aneel`: referência GLOBAL e só de leitura com a tarifa oficial (TE, TUSD e TUSD_FioB em R$/MWh, sem
+--     tributos) por distribuidora e vigência, com a fonte (recurso e linhas da ANEEL, data de extração, hash da resposta).
+--     É dado público da ANEEL, não da empresa: ninguém grava pelo app (sem política de escrita); a carga é por migration.
+--     `pendencias_fonte` guarda o que ainda não foi lido na fonte (ex.: Tabela 4 da REH), sem declarar conferido.
+--  2) `calculos_solares`: retrato do que cada cálculo usou (data de referência, tarifa e base tributária declarada, origem,
+--     linha oficial, Fio B, percentual legal, vigência, autoconsumo, energia não compensada, ressalvas) e a marca de
+--     desatualização (R6.2). `tarifa_kwh` passa de 4 para 5 casas (a tarifa oficial em R$/kWh tem 5: 0,76802).
+--     O estado `completo` exige o retrato inteiro, base da tarifa = base do Fio B e payback nulo (indisponível no P0).
+--  3) `calculos_solares_historico`: cópia imutável da linha `legado`/`completo` substituída (R6.1), gravada por trigger
+--     na mesma instrução do upsert; motivo `desatualizado_por_entradas` quando o resultado novo é incompleto (R6.2).
+--
+-- Linhas existentes: nada é reescrito além da mudança de escala de `tarifa_kwh` (valores preservados) e as colunas novas
+-- nascem nulas. Linhas `legado` continuam válidas.
+
+-- 1) Tarifa oficial de referência -------------------------------------------------------------------------------------
+create table public.tarifas_gd_aneel (
+  id uuid primary key default gen_random_uuid(),
+  distribuidora text not null check (length(btrim(distribuidora)) > 0), -- SigNomeAgente da ANEEL (ex.: COPEL-DIS)
+  nomes_aceitos text[] not null check (cardinality(nomes_aceitos) > 0), -- formas normalizadas (minúsculas, sem acento)
+  cnpj text not null,
+  ato text not null, -- REH que homologou a tarifa
+  subgrupo text not null, -- B1
+  subclasse text not null, -- residencial
+  modalidade text not null, -- convencional
+  base_tributaria text not null check (base_tributaria in ('com_tributos', 'sem_tributos')),
+  te_rs_mwh numeric(18, 9) not null check (te_rs_mwh > 0),
+  tusd_rs_mwh numeric(18, 9) not null check (tusd_rs_mwh > 0),
+  tusd_fio_b_rs_mwh numeric(18, 9) not null check (tusd_fio_b_rs_mwh > 0),
+  vigencia_inicio date not null,
+  vigencia_fim date not null,
+  fonte_recurso_id text not null,
+  fonte_linhas jsonb not null, -- _id das linhas usadas, por componente
+  fonte_extraida_em timestamptz not null,
+  fonte_resposta_sha256 text not null check (fonte_resposta_sha256 ~ '^[0-9a-f]{64}$'),
+  pendencias_fonte text[] not null default '{}',
+  created_at timestamptz not null default now(),
+  check (vigencia_fim >= vigencia_inicio),
+  unique (distribuidora, subgrupo, subclasse, modalidade, vigencia_inicio)
+);
+
+alter table public.tarifas_gd_aneel enable row level security;
+create policy "ver tarifas oficiais" on public.tarifas_gd_aneel for select to authenticated using (true);
+-- Sem política de insert/update/delete: só migration (ou service role) altera a referência.
+revoke insert, update, delete, truncate on public.tarifas_gd_aneel from anon, authenticated;
+
+comment on table public.tarifas_gd_aneel is
+  'Tarifa oficial (ANEEL, sem tributos, R$/MWh) por distribuidora/vigência, com a fonte. Só leitura pelo app.';
+comment on column public.tarifas_gd_aneel.pendencias_fonte is
+  'O que ainda não foi lido na fonte oficial (ex.: tabela4_nao_conferida). Nunca removido sem a leitura do documento.';
+
+-- Copel, REH 3.592/2026 (.aurora/fontes/aneel-componentes-2026-copel-reh3592-b1.json). TE e TUSD: detalhe "Não se
+-- aplica"; TUSD_FioB: detalhe SCEE (mesmo valor no "Não se aplica"). Valores do campo numeric(18,9) da ANEEL, sem o
+-- ruído de ponto flutuante do JSON ("214,53560037400001" = 214,535600374).
+insert into public.tarifas_gd_aneel (
+  distribuidora, nomes_aceitos, cnpj, ato, subgrupo, subclasse, modalidade, base_tributaria,
+  te_rs_mwh, tusd_rs_mwh, tusd_fio_b_rs_mwh, vigencia_inicio, vigencia_fim,
+  fonte_recurso_id, fonte_linhas, fonte_extraida_em, fonte_resposta_sha256, pendencias_fonte
+) values (
+  'COPEL-DIS',
+  array['copel', 'copel-dis', 'copel dis', 'copel distribuicao', 'copel distribuicao s.a.', 'copel distribuicao sa'],
+  '04368898000106', 'REH 3.592/2026', 'B1', 'residencial', 'convencional', 'sem_tributos',
+  310.85, 457.17, 214.535600374, date '2026-06-24', date '2027-06-23',
+  'e8717aa8-2521-453f-bf16-fbb9a16eea39',
+  '{"TE": [924996, 925000], "TUSD": [892207, 892275], "TUSD_FioB_SCEE": [887694, 923614]}'::jsonb,
+  timestamptz '2026-10-22 20:58:09-03',
+  '6f0c3eff81fdac782250b27c121c1c29447d05915dcf4f56c44cadca20a02eef',
+  array['tabela4_nao_conferida']
+);
+
+-- 2) Retrato por cálculo ------------------------------------------------------------------------------------------------
+alter table public.calculos_solares alter column tarifa_kwh type numeric(9, 5);
+
+alter table public.calculos_solares
+  add column data_referencia date,
+  add column tarifa_base_tributaria text check (tarifa_base_tributaria is null or tarifa_base_tributaria in ('com_tributos', 'sem_tributos')),
+  add column tarifa_origem text check (tarifa_origem is null or tarifa_origem in ('oficial_aneel', 'informada_vendedor')),
+  add column tarifa_gd_id uuid references public.tarifas_gd_aneel (id) on delete restrict,
+  add column distribuidora text,
+  add column enquadramento text, -- ex.: B1/residencial/convencional/GD_II
+  add column fio_b_rs_mwh numeric(18, 9) check (fio_b_rs_mwh is null or fio_b_rs_mwh > 0),
+  add column fio_b_base_tributaria text check (fio_b_base_tributaria is null or fio_b_base_tributaria in ('com_tributos', 'sem_tributos')),
+  add column percentual_legal_fio_b numeric(4, 3) check (percentual_legal_fio_b is null or (percentual_legal_fio_b > 0 and percentual_legal_fio_b <= 1)),
+  add column fio_b_vigencia_inicio date,
+  add column fio_b_vigencia_fim date,
+  add column autoconsumo_kwh numeric(10, 2) check (autoconsumo_kwh is null or autoconsumo_kwh >= 0),
+  add column kwh_nao_compensado numeric(10, 2) check (kwh_nao_compensado is null or kwh_nao_compensado >= 0),
+  add column ressalvas text[],
+  add column financeiro_desatualizado_em timestamptz,
+  add column financeiro_desatualizado_motivo text;
+
+create index calculos_solares_tarifa_gd_idx on public.calculos_solares (tarifa_gd_id) where tarifa_gd_id is not null;
+
+alter table public.calculos_solares drop constraint calculos_solares_estado_coerente_ck;
+alter table public.calculos_solares
+  add constraint calculos_solares_estado_coerente_ck check (
+    case estado_financeiro
+      when 'incompleto' then
+        kwh_faturado is null and kwh_compensado is null and custo_fio_b is null
+        and conta_sem_solar is null and conta_com_solar is null and economia_mensal is null
+        and payback_meses is null and metodo_calculo is null and kwh_nao_compensado is null
+        and financeiro_desatualizado_em is null
+        and coalesce(jsonb_typeof(pendencias) = 'array' and pendencias <> '[]'::jsonb, false)
+      when 'legado' then
+        kwh_faturado is not null and kwh_compensado is not null and custo_fio_b is not null
+        and conta_sem_solar is not null and conta_com_solar is not null and economia_mensal is not null
+        and metodo_calculo is null and pendencias is null
+      when 'completo' then
+        kwh_faturado is not null and kwh_compensado is not null and custo_fio_b is not null
+        and conta_sem_solar is not null and conta_com_solar is not null and economia_mensal is not null
+        and length(btrim(coalesce(metodo_calculo, ''))) > 0 and pendencias is null
+        -- payback indisponível no P0 (contrato, seção 4)
+        and payback_meses is null
+        -- retrato completo, com a base da tarifa igual à do Fio B (contrato, seção 5)
+        and data_referencia is not null and tarifa_origem is not null and tarifa_gd_id is not null
+        and distribuidora is not null and enquadramento is not null and fio_b_rs_mwh is not null and percentual_legal_fio_b is not null
+        and fio_b_vigencia_inicio is not null and fio_b_vigencia_fim is not null
+        and data_referencia between fio_b_vigencia_inicio and fio_b_vigencia_fim
+        and autoconsumo_kwh is not null and kwh_nao_compensado is not null
+        and tarifa_base_tributaria is not null and tarifa_base_tributaria = fio_b_base_tributaria
+      else false
+    end
+  ),
+  add constraint calculos_solares_desatualizado_ck check (
+    (financeiro_desatualizado_em is null) = (financeiro_desatualizado_motivo is null)
+  );
+
+comment on column public.calculos_solares.tarifa_base_tributaria is
+  'Base declarada da tarifa usada como T (sem_tributos | com_tributos). Nula = não declarada (linha legada ou entrada sem declaração).';
+comment on column public.calculos_solares.tarifa_origem is
+  'oficial_aneel = igual à TE+TUSD da linha oficial vigente; informada_vendedor = valor digitado diferente dela.';
+comment on column public.calculos_solares.ressalvas is
+  'Limitações declaradas da estimativa (ex.: autoconsumo_zero, tabela4_nao_conferida, payback_indisponivel).';
+comment on column public.calculos_solares.financeiro_desatualizado_em is
+  'R6.2: entradas mudaram depois deste resultado sem resultado novo gravado. Bloqueia proposta e preço; sai ao recalcular.';
+
+-- 3) Histórico imutável ------------------------------------------------------------------------------------------------
+create table public.calculos_solares_historico (
+  id uuid primary key default gen_random_uuid(),
+  calculo_id uuid not null,
+  empresa_id uuid not null references public.empresas (id) on delete cascade,
+  negocio_id uuid not null references public.negocios (id) on delete cascade,
+  arquivado_em timestamptz not null default now(),
+  motivo text not null check (motivo in ('desatualizado_por_entradas', 'substituido_por_recalculo')),
+  linha jsonb not null
+);
+create index calculos_solares_historico_negocio_idx on public.calculos_solares_historico (negocio_id, arquivado_em desc);
+create index calculos_solares_historico_empresa_idx on public.calculos_solares_historico (empresa_id);
+
+alter table public.calculos_solares_historico enable row level security;
+create policy "ver histórico do cálculo" on public.calculos_solares_historico for select to authenticated
+  using (public.pode_ver_negocio(negocio_id));
+-- Sem política de escrita: só o trigger abaixo (security definer) grava; ninguém altera nem apaga pelo app.
+revoke insert, update, delete, truncate on public.calculos_solares_historico from anon, authenticated;
+
+comment on table public.calculos_solares_historico is
+  'Cópia imutável (R6.1) de cada linha legado/completo substituída em calculos_solares. Nunca é resultado atual.';
+
+-- Arquiva a linha legado/completo quando o conteúdo do cálculo muda (preço do kit, payback, observações e a própria marca
+-- de desatualização não contam: não alteram o resultado). Roda depois da trava de negócio arquivado (ordem alfabética).
+create or replace function public.calculos_solares_arquivar_historico()
+returns trigger
+language plpgsql security definer set search_path = ''
+as $$
+declare
+  v_ignorar text[] := array[
+    'updated_at', 'atualizado_por', 'observacoes', 'kit_preco', 'payback_meses',
+    'financeiro_desatualizado_em', 'financeiro_desatualizado_motivo'
+  ];
+begin
+  if old.estado_financeiro in ('legado', 'completo')
+     and (to_jsonb(old) - v_ignorar) is distinct from (to_jsonb(new) - v_ignorar) then
+    insert into public.calculos_solares_historico (calculo_id, empresa_id, negocio_id, motivo, linha)
+    values (
+      old.id, old.empresa_id, old.negocio_id,
+      case when new.estado_financeiro = 'incompleto' then 'desatualizado_por_entradas' else 'substituido_por_recalculo' end,
+      to_jsonb(old)
+    );
+  end if;
+  return new;
+end;
+$$;
+
+revoke execute on function public.calculos_solares_arquivar_historico() from public, anon, authenticated;
+
+create trigger calculos_solares_historico before update on public.calculos_solares
+  for each row execute function public.calculos_solares_arquivar_historico();
diff --git a/supabase/migrations/20261023220000_calculos_solares_gravacao_servidor.sql b/supabase/migrations/20261023220000_calculos_solares_gravacao_servidor.sql
new file mode 100644
index 0000000..e6fcf41
--- /dev/null
+++ b/supabase/migrations/20261023220000_calculos_solares_gravacao_servidor.sql
@@ -0,0 +1,108 @@
+-- Cálculo solar gravado só pelo servidor (M2 P0, revisão da calculadora GD II; Evandro, 23/10/2026).
+--
+-- Brecha fechada: as policies "criar cálculo"/"editar cálculo" deixavam qualquer membro que vê o negócio gravar, pelo
+-- PostgREST, qualquer coluna de `calculos_solares`: economia, contas, método, percentual, fonte tarifária, autoria e
+-- o estado `completo` (ou uma linha `legado` com economia). Provado em .aurora/revisao/calc-gd2/logs/19*.log.
+--
+-- Mecanismo (o menor que mantém um motor só, em TypeScript, src/lib/calculadora.ts):
+--   1) `authenticated` perde INSERT e UPDATE na tabela: fica na migration 20261023240000 (CONTRAÇÃO), aplicada só
+--      depois que a versão do app que grava pelo servidor estiver no ar. Esta migration só ACRESCENTA (RPC e trigger)
+--      e é compatível com a versão anterior do app, que ainda grava direto (linhas `legado`; nunca `completo`).
+--   2) `autorizar_gravacao_calculo(negocio)`: chamada com a sessão do usuário, só CONFERE (acesso comercial à empresa
+--      do negócio, ver o negócio, negócio não arquivado) e devolve a empresa e o membro da sessão (autoria real). Não
+--      grava nada e não recebe valor nenhum.
+--   3) O servidor (src/lib/calculo-gravacao.ts) grava com a service role a linha que ELE montou pelo motor, com as
+--      entradas validadas e a referência tarifária lida da tabela oficial; empresa e autoria vêm do passo 2.
+--   4) Defesa no banco, para qualquer escritor (inclusive a service role): linha `completo` só com o método aceito e
+--      o retrato igual à linha oficial de `tarifas_gd_aneel` (fonte, Fio B, base, vigência, enquadramento), o
+--      percentual legal do ano da data de referência e o piso do art. 291 da ligação. Não refaz a conta (isso
+--      duplicaria o motor); confere que a REFERÊNCIA usada é a autorizada.
+
+-- ---------------------------------------------------------------------------
+-- 2) Autorização (sem escrita)
+-- ---------------------------------------------------------------------------
+create or replace function public.autorizar_gravacao_calculo(p_negocio_id uuid)
+returns table (empresa_id uuid, membro_id uuid)
+language plpgsql stable security definer set search_path = ''
+as $$
+declare
+  v_empresa uuid;
+  v_arquivado timestamptz;
+  v_membro uuid;
+begin
+  select n.empresa_id, n.arquivado_em into v_empresa, v_arquivado from public.negocios n where n.id = p_negocio_id;
+  if v_empresa is null
+     or not public.tem_acesso_comercial(v_empresa)
+     or not public.pode_ver_negocio(p_negocio_id) then
+    raise exception 'Sem permissão para gravar o cálculo deste negócio.' using errcode = '42501', hint = 'mensagem_usuario';
+  end if;
+  if v_arquivado is not null then
+    raise exception 'Negócio arquivado: o cálculo é só leitura.' using errcode = '42501', hint = 'mensagem_usuario';
+  end if;
+  v_membro := public.meu_membro_id(v_empresa);
+  if v_membro is null then
+    raise exception 'Sem permissão para gravar o cálculo deste negócio.' using errcode = '42501', hint = 'mensagem_usuario';
+  end if;
+  return query select v_empresa, v_membro;
+end;
+$$;
+revoke all on function public.autorizar_gravacao_calculo(uuid) from public, anon, authenticated, service_role;
+grant execute on function public.autorizar_gravacao_calculo(uuid) to authenticated;
+comment on function public.autorizar_gravacao_calculo(uuid) is
+  'Só confere: o usuário da sessão pode gravar o cálculo deste negócio (acesso comercial, vê o negócio, não arquivado). Devolve empresa e membro (autoria). Não grava.';
+
+-- ---------------------------------------------------------------------------
+-- 4) Linha `completo` só com a referência oficial
+-- ---------------------------------------------------------------------------
+create or replace function public.calculos_solares_conferir_referencia()
+returns trigger
+language plpgsql security definer set search_path = ''
+as $$
+declare
+  t public.tarifas_gd_aneel%rowtype;
+begin
+  if new.estado_financeiro is distinct from 'completo' then
+    return new;
+  end if;
+  -- Num UPDATE que não toca o retrato (preço, marca de desatualização, observações), não reconfere.
+  if tg_op = 'UPDATE' and old.estado_financeiro = 'completo'
+     and (new.metodo_calculo, new.tarifa_gd_id, new.distribuidora, new.enquadramento, new.fio_b_rs_mwh,
+          new.fio_b_base_tributaria, new.fio_b_vigencia_inicio, new.fio_b_vigencia_fim, new.percentual_legal_fio_b,
+          new.data_referencia, new.disponibilidade_kwh, new.tipo_ligacao, new.tarifa_kwh, new.tarifa_origem,
+          new.tarifa_base_tributaria)
+     is not distinct from
+         (old.metodo_calculo, old.tarifa_gd_id, old.distribuidora, old.enquadramento, old.fio_b_rs_mwh,
+          old.fio_b_base_tributaria, old.fio_b_vigencia_inicio, old.fio_b_vigencia_fim, old.percentual_legal_fio_b,
+          old.data_referencia, old.disponibilidade_kwh, old.tipo_ligacao, old.tarifa_kwh, old.tarifa_origem,
+          old.tarifa_base_tributaria) then
+    return new;
+  end if;
+
+  select * into t from public.tarifas_gd_aneel where id = new.tarifa_gd_id;
+  if not found
+     -- Método aceito (src/lib/fio-b-gd2.ts, METODO_GD2_PISO_V1).
+     or new.metodo_calculo is distinct from 'gd2_piso_655i_v1'
+     or new.distribuidora is distinct from t.distribuidora
+     or new.enquadramento is distinct from (t.subgrupo || '/' || t.subclasse || '/' || t.modalidade || '/GD_II')
+     or new.fio_b_rs_mwh is distinct from t.tusd_fio_b_rs_mwh
+     or new.fio_b_base_tributaria is distinct from t.base_tributaria
+     or new.fio_b_vigencia_inicio is distinct from t.vigencia_inicio
+     or new.fio_b_vigencia_fim is distinct from t.vigencia_fim
+     or new.data_referencia not between t.vigencia_inicio and t.vigencia_fim
+     -- Percentual legal do ano (Lei 14.300, art. 27; src/lib/tarifa-gd.ts, PERCENTUAL_LEGAL_FIO_B_GD2).
+     or new.percentual_legal_fio_b is distinct from (case extract(year from new.data_referencia)::int when 2026 then 0.6 when 2027 then 0.75 end)
+     -- Piso do art. 291 da REN 1.000 pela ligação (src/lib/tarifa-gd.ts, DISPONIBILIDADE_ART_291).
+     or new.disponibilidade_kwh is distinct from (case new.tipo_ligacao when 'monofasico' then 30 when 'bifasico' then 50 when 'trifasico' then 100 end)
+     -- "Oficial" só quando a tarifa é exatamente TE + TUSD da linha (5 casas).
+     or (new.tarifa_origem = 'oficial_aneel' and new.tarifa_kwh is distinct from round((t.te_rs_mwh + t.tusd_rs_mwh) / 1000, 5)) then
+    raise exception 'Cálculo completo com referência tarifária diferente da oficial. Nada foi alterado.'
+      using errcode = 'check_violation', hint = 'mensagem_usuario';
+  end if;
+  return new;
+end;
+$$;
+revoke all on function public.calculos_solares_conferir_referencia() from public, anon, authenticated, service_role;
+
