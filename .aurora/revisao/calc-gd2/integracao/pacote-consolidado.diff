+});
+
+describe("preço do negócio", () => {
+  it("congela o valor atual do negócio, sem cálculo financeiro nem recálculo", () => {
+    expect(dadosValidos({ valorNegocio: 31890.5 }).preco.valor).toBe(31890.5);
