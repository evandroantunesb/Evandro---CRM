+} from "@/lib/calculo-vigencia";
+import type { ContextoEstimativa, TarifaGd } from "@/lib/tarifa-gd";
+
+const modulo = (quantidade: number, potencia_w: number | null = 550): ComponenteKitVigencia => ({ tipo: "modulo", potencia_w, quantidade });
