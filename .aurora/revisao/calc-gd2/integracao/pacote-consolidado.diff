+
+  it("o caminho do PDF precisa ser <empresa>/<negócio>/<id>.pdf", async () => {
+    const { error } = await comoServico(await montarLinha(a, vendedor, { pdf_caminho: "qualquer/coisa.pdf" }));
+    expect(error).not.toBeNull();
+  });
