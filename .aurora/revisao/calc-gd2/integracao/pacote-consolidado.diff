+  if (enq.situacao !== "ok" || rotuloEnquadramento(enq.enquadramento) !== calculo.enquadramento) return true;
+  const tarifa = resolverTarifa(ctx.tarifas, ctx.distribuidoraInformada, enq.enquadramento, ctx.dataReferencia);
