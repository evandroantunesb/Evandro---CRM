+      .maybeSingle(),
+    supabase.from("proposta_identidades").select("nome_exibicao, cor_primaria, cor_destaque, whatsapp, logo_url, logo_escuro_url, foto_capa_url").eq("empresa_id", atual.empresaId).maybeSingle(),
