+  it("varredura: 0 <= K <= min(C,E), K + (E-K) = E, conta >= piso, economia >= 0", () => {
+    for (const c of [0, 10, 30, 31, 100, 500, 1000]) {
+      for (const e of [0, 1, 50, 100, 500, 2000]) {
