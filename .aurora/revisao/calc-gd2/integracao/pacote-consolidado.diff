+    supabase
+      .from("proposta_modelos")
+      .select("proposta_modelo_blocos(tipo, ativo, config)")
+      .eq("empresa_id", atual.empresaId)
+      .eq("status", "publicado")
+      .eq("padrao", true)
+      .maybeSingle(),
