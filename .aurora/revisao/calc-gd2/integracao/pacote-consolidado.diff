+        expect(r.energiaCompensadaKwh + r.energiaDisponivelNaoCompensadaKwh).toBeCloseTo(e, 2);
+        expect(r.contaComSolar).toBeGreaterThanOrEqual(30);
+        expect(r.economiaMensal).toBeGreaterThanOrEqual(0);
+      }
+    }
+  });
+});
