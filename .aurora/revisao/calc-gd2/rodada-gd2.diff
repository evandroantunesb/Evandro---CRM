+    await expect(page.getByTestId("detalhes-tecnicos")).toContainText("Data de referência: 22/10/2026.");
+
+    // Salvar: linha completa com o retrato dos parâmetros.
+    await page.getByRole("button", { name: /^Salvar kit/ }).click();
