+    expect(hist).toHaveLength(1);
+    expect(hist![0]!.motivo).toBe("desatualizado_por_entradas");
+    expect(hist![0]!.linha).toMatchObject({ estado_financeiro: "completo", economia_mensal: 191.79, tarifa_base_tributaria: "sem_tributos" });
