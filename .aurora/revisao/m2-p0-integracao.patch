+      achados.add("kit");
+    }
+  } else if (
+    potenciaDoKitKwp(atual.componentes) !== valorComoPersistido(calculo.kit_potencia_kwp, 2) ||
+    nomeDoKitAtual(atual.componentes) !== calculo.kit_nome
+  ) {
+    achados.add("kit");
+  }
