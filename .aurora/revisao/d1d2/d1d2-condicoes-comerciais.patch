+// ---------------------------------------------------------------------------
+
+export const PRAZOS_VALIDADE = [7, 15, 30] as const;
+export type PrazoValidade = (typeof PRAZOS_VALIDADE)[number];
+
+export const FORMAS_PAGAMENTO = [
+  ["avista", "À vista"],
+  ["cartao", "Cartão"],
+  ["financiamento", "Financiamento"],
+] as const;
+
+export type CondicoesComerciais = { validadeDias: number | null; avista: string | null; cartao: string | null; financiamento: string | null };
+
+/** Linha de `proposta_condicoes_comerciais` (ou a falta dela) no formato da montagem. */
+export function condicoesComerciaisDaEmpresa(
+  linha: { validade_dias: number | null; pagamento_avista: string | null; pagamento_cartao: string | null; pagamento_financiamento: string | null } | null | undefined,
+): CondicoesComerciais | null {
+  if (!linha) return null;
+  const t = (v: string | null) => v?.trim() || null;
+  return { validadeDias: linha.validade_dias, avista: t(linha.pagamento_avista), cartao: t(linha.pagamento_cartao), financiamento: t(linha.pagamento_financiamento) };
+}
