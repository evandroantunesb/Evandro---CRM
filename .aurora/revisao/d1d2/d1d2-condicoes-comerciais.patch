+
+/** O que falta na configuração para emitir (vazio = completa). */
+export function pendenciasDasCondicoes(c: CondicoesComerciais | null): string[] {
+  if (!c) return [MENSAGEM_CONDICOES_NAO_CONFIGURADAS];
+  const faltam: string[] = [];
+  if (!PRAZOS_VALIDADE.includes(c.validadeDias as PrazoValidade)) faltam.push("o prazo de validade");
+  for (const [chave, rotulo] of FORMAS_PAGAMENTO) if (!c[chave]) faltam.push(`a condição "${rotulo}"`);
